[server]
hosts = 0.0.0.0:5232

[storage]
filesystem_folder = /data/collections

[auth]
# Authelia has already authenticated the request (via the Traefik
# forward-auth middleware) before it reaches Radicale, and forwards the
# username in the Remote-User header. Radicale trusts that header here
# instead of asking for a second login.
type = remote_user
